# Network the app talks to (MST Coral Testnet by default)
NEXT_PUBLIC_CHAIN_ID=54635
NEXT_PUBLIC_RPC_URL=https://coralrpc.mstblockchain.com
# From contracts/deployments/<network>.json after running the deploy script
NEXT_PUBLIC_REGISTRY_ADDRESS=
NEXT_PUBLIC_REGISTRY_DEPLOY_BLOCK=
# Postgres connection string (Supabase works). Leave blank to use an embedded PGlite database in ./.data
DATABASE_URL=
# Long random string used to sign session cookies: openssl rand -hex 32
SESSION_SECRET=
